  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "types": ["node"], "lib": ["es2023", "dom"],
    "noUncheckedSideEffectImports": false
